# Copy to .env on the server and fill in every value. Never commit .env.

# Your domain (DNS A record must point to the VPS IP) and an email for Let's Encrypt.
DOMAIN=urbanfruto.com
ACME_EMAIL=you@example.com

# MongoDB (runs inside Docker, not exposed). Use long random values:
#   openssl rand -hex 24
MONGO_USER=urbanfruto
MONGO_PASSWORD=
DB_NAME=urbanfruto

# Signs admin sessions. Generate with: openssl rand -hex 32
# (Admins are NOT configured here. Create them with scripts/create_admin.py, see DEPLOY.md.)
JWT_SECRET=

# Optional: Slack incoming webhook for new enquiries.
SLACK_WEBHOOK_URL=

# Cloudflare R2 (images).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=urbanfruto
R2_PUBLIC_URL=
